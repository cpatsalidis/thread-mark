<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coming soon...</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
        rel="stylesheet">
    <style>
        html {
            width: 100%;
            min-height: 100vh;
            background-image: url("ChatGPT Image May 30, 2025, 03_21_09 PM.png");
            background-color: rgb(240, 244, 239);
            background-repeat: repeat-x;
            background-size: contain;
        }

        @media only screen and (max-width: 850px) {
            html {
                background-size: cover;
            }
        }

        body {
            display: flex;
            justify-content: center;
            align-items: start;
        }

        .cont {
            display: flex;
            justify-content: center;
            align-items: center;
            padding-top: 50px;
            width: 320px;
            height: 320px;
        }

        img {
            width: 100%;
            height: 100%;
        }

        div.item {
            vertical-align: top;
            display: inline-block;
            text-align: center;
            width: 100%;
        }

        .caption {
            display: block;
        }

        .be-with-you {
            font-family: "Dancing Script", cursive;
            font-size: 1.9rem;
            color: #000000;
            /* dark green-gray tone */
            letter-spacing: 0.5px;
            text-align: center;
            display: block;
        }

        .dots::after {
            content: '';
            display: inline-block;
            animation: dots 3s steps(4, end) infinite;
            font-weight: 400;
        }

        @keyframes dots {
            0% {
                content: '';
            }

            25% {
                content: '.';
            }

            50% {
                content: '..';
            }

            75% {
                content: '...';
            }

            100% {
                content: '';
            }
        }
    </style>
</head>

<body>
    <div class="cont">
        <div class="item">
            <img src="ChatGPT Image May 30, 2025, 04_14_19 PM.png">
            <span class="item be-with-you">Be with you shortly<span class="dots"></span></span>
        </div>
    </div>
</body>

</html>